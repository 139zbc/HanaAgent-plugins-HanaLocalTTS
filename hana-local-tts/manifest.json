{
  "manifestVersion": 2,
  "id": "hana-local-tts",
  "name": "\u672c\u5730\u8bed\u97f3\u6717\u8bfb",
  "version": "0.3.0",
  "entry": "index.js",
  "capabilities": [
    "app/process.spawn"
  ],
  "contributes": {
    "ui": {
      "messageActions": [
        {
          "id": "speak",
          "title": "朗读",
          "messages": "assistant",
          "toolName": "hana_local_tts_speak"
        }
      ]
    },
    "settings": {
      "title": "本地语音朗读",
      "schema": {
        "properties": {
          "voice": {
            "type": "string",
            "title": "声音",
            "default": ""
          },
          "rate": {
            "type": "number",
            "title": "语速",
            "default": 1
          }
        }
      },
      "ui": { "route": "/settings.html" }
    },
    "cards": [
      {
        "id": "panel",
        "title": "\u672c\u5730\u8bed\u97f3\u6717\u8bfb",
        "route": "/panel.html",
        "face": {
          "image": "assets/cover.png"
        }
      }
    ]
  },
  "icon": "assets/icon.jpg",
  "minAppVersion": "1.2.1-beta"
}
